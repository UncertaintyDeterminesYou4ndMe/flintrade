# Flintrade 凭据 + 运行开关 —— 模板。只放占位,真实值只进下面说的凭据文件,永不进版本库。
#
# 放哪(daemon 与 bin/flintrade 按此顺序找,用第一个):
#   1. $FLINTRADE_CREDENTIALS 指向的文件
#   2. ~/Library/Application Support/Flintrade/credentials.env(存在时;推荐,在仓库之外)
#   3. <repo>/flintrade.env(已 gitignore)
# scripts/bootstrap.sh 会把本模板装到第 2 个位置(目录 0700、文件 0600)。手动装:
#   mkdir -p -m 700 ~/Library/Application\ Support/Flintrade
#   install -m 600 flintrade.env.example ~/Library/Application\ Support/Flintrade/credentials.env
#
# 规则:
#   - 权限保持 600;组/其他可读时 daemon 与 bin/flintrade check 会告警。
#   - 文件里的值覆盖 shell 环境变量(含 FLINTRADE_DRY_RUN)。daemon 每次启动自己读它,
#     launchd plist 里不放任何凭据。改完重启:launchctl kickstart -k gui/$(id -u)/com.flintrade.daemon
#   - 格式是 shell 赋值:KEY='值' 或 export KEY="值"。不支持 $VAR / `cmd` 展开。
#   - 自检(不打印任何值):bin/flintrade check
# 这是 paper trading 账户(token 内 ac=lb_papertrading),但仍按真实凭据对待。

# Longbridge 开放平台(免费模拟盘):https://open.longbridge.com
export LONGBRIDGE_APP_KEY=''
export LONGBRIDGE_APP_SECRET=''
export LONGBRIDGE_ACCESS_TOKEN=''

# "1" = 干跑:内部模拟成交,绝不下单(默认,不设也是干跑)。
# "0" = 在 Longbridge 模拟盘真实下单(无真钱)。只接受 "0" 或 "1"。
export FLINTRADE_DRY_RUN='1'

# ── LLM provider(可选)────────────────────────────────────────────────────
# 默认走本机 Claude Code CLI(claude 命令),不需要任何 key。
# 想换厂商:改 agent/config/trading.toml [models],并在这里放对应 key。
# 自检:bin/flintrade check(零成本);连通:bin/flintrade ping(每档真调一次,花钱)
# export ANTHROPIC_API_KEY='sk-ant-…'    # provider = "anthropic"
# export OPENAI_API_KEY='sk-…'           # provider = "openai"
# export DEEPSEEK_API_KEY='sk-…'         # provider = "deepseek"
# export MOONSHOT_API_KEY='sk-…'         # provider = "moonshot"(Kimi 开放平台,按量)
# export KIMI_PLAN_API_KEY='sk-kimi-…'   # provider = "kimi-plan"(Kimi Code plan key 直连,可用他人共享的)
# export OPENROUTER_API_KEY='sk-or-…'    # provider = "openrouter"
# export LLM_API_KEY='…'                 # provider = "openai_compatible"(或在 trading.toml 用 api_key_env 自定义变量名)
# provider = "ollama" 本地模型无需 key
# provider = "claude-cli" / "kimi-cli" 走本机 CLI 吃订阅(claude / kimi login),无需 key
