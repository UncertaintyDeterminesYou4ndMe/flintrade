logs/
*.log
__pycache__/
.DS_Store
autoresearch-results.tsv

# Credentials — NEVER commit. They live in ~/Library/Application Support/Flintrade/credentials.env;
# a repo-local flintrade.env is only the last fallback (internal/creds).
flintrade.env
flintrade.env.local

# Flintrade agent SQLite (runtime state, not versioned)
flintrade.db
flintrade.db-wal
flintrade.db-shm

# Python-era leftovers, in case an old checkout recreates them
.venv/
flintrade_lance/
.daemon.lock

# launchd plist has machine-specific absolute paths (no credentials); export_oss.sh emits a template
launchd/com.flintrade.daemon.plist

# web SPA build artifacts
web/node_modules/
web/dist/

# market-data payloads — 可由 backtest/download_*.py 按 manifest 重建,不入库
backtest/data/
backtest/data_1m/
backtest/data_1h/*_US.json
backtest/data_1h_2025/*_US.json
backtest/data_playbook/
llm_calls/

# 月报是生成物(scratchpad 里的生成器 + flintrade.db 直算),不进版本库
reports/flintrade-monthly-*.html
reports/flintrade-monthly-*.docx

# Go build output
bin/

# Flintrade.app bundles (go tool mygo build)
build/
.mygo/
cmd/flintrade-app/flintrade-app
