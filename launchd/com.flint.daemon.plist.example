<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.flint.daemon</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>WorkingDirectory</key>
    <string>/path/to/flintrade</string>
    <key>ProgramArguments</key>
    <array>
        <string>/path/to/flintrade/.venv/bin/python</string>
        <string>-m</string>
        <string>agent.daemon</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>LONGBRIDGE_APP_KEY</key><string>YOUR_APP_KEY</string>
        <key>LONGBRIDGE_APP_SECRET</key><string>YOUR_APP_SECRET</string>
        <key>LONGBRIDGE_ACCESS_TOKEN</key><string>YOUR_ACCESS_TOKEN</string>
        <!-- SAFETY: "1" = dry-run (simulate fills, place NO orders). Flip to "0" deliberately. -->
        <key>FLINT_DRY_RUN</key><string>1</string>
    </dict>
    <key>StandardOutPath</key><string>/path/to/flintrade/logs/daemon.out</string>
    <key>StandardErrorPath</key><string>/path/to/flintrade/logs/daemon.err</string>
</dict>
</plist>
