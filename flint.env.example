# Flint 凭据 + 运行开关 —— 模板。复制为 flint.env 并填入真实值。
#   cp flint.env.example flint.env  &&  $EDITOR flint.env
# flint.env 已 gitignore,永不进版本库。run.sh 与 scripts/agentctl.sh 都从它加载。
# 这是 paper trading 账户(token 内 ac=lb_papertrading),但仍按真实凭据对待。

export LONGBRIDGE_APP_KEY="<your-app-key>"
export LONGBRIDGE_APP_SECRET="<your-app-secret>"
export LONGBRIDGE_ACCESS_TOKEN="<your-access-token>"

# LIVE:在 Longbridge 模拟盘真实下单(无真钱)。"1" = 纯内部模拟,绝不下单(默认更安全)。
export FLINT_DRY_RUN="1"

# ── LLM provider(可选)────────────────────────────────────────────────────
# 默认走本机 Claude Code CLI(claude 命令),不需要任何 key。
# 想换厂商:改 agent/config/trading.toml [models],并在这里放对应 key。
# 自检:python -m agent.llm check
# export ANTHROPIC_API_KEY="sk-ant-…"    # provider = "anthropic"
# export OPENAI_API_KEY="sk-…"           # provider = "openai"
# export DEEPSEEK_API_KEY="sk-…"         # provider = "deepseek"
# export MOONSHOT_API_KEY="sk-…"         # provider = "moonshot"(Kimi)
# export OPENROUTER_API_KEY="sk-or-…"    # provider = "openrouter"
# provider = "ollama" 本地模型无需 key
# provider = "claude-cli" / "kimi-cli" 走本机 CLI 吃订阅(claude / kimi login),无需 key
