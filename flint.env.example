# Flint 凭据 + 运行开关 —— 模板。复制为 flint.env 并填入真实值。
#   cp flint.env.example flint.env  &&  $EDITOR flint.env
# flint.env 已 gitignore,永不进版本库。run.sh 与 scripts/agentctl.sh 都从它加载。
# 这是 paper trading 账户(token 内 ac=lb_papertrading),但仍按真实凭据对待。

export LONGBRIDGE_APP_KEY="<your-app-key>"
export LONGBRIDGE_APP_SECRET="<your-app-secret>"
export LONGBRIDGE_ACCESS_TOKEN="<your-access-token>"

# LIVE:在 Longbridge 模拟盘真实下单(无真钱)。"1" = 纯内部模拟,绝不下单(默认更安全)。
export FLINT_DRY_RUN="1"
